# Simulated users, about one request a second. A systemd user unit:
#   cp demo/systemd/demo-traffic.service ~/.config/systemd/user/ && systemctl --user daemon-reload
#   systemctl --user enable --now demo-traffic.service
[Unit]
Description=Simulated users against the demo stack (Locust, low rate)
After=network.target

[Service]
WorkingDirectory=%h/unbidden-demo-fastapi
ExecStart=%h/.local/bin/uv tool run --from locust locust -f %h/unbidden-demo-fastapi/loadtest/locustfile.py --headless -u 4 -r 1 --host http://127.0.0.1:8100 --only-summary
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
